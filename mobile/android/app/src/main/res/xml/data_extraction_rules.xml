<?xml version="1.0" encoding="utf-8"?>
<!-- Bank detections stay on this phone: never in cloud backups or device transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="vela_sms.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="vela_sms.xml" />
    </device-transfer>
</data-extraction-rules>
