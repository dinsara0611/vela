<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_body" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="10dp"
    android:paddingTop="6dp" android:paddingBottom="6dp" android:background="@drawable/widget_bg_orange">
    <LinearLayout android:layout_width="40dp" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/widget_cal_tile_sm">
        <TextView android:id="@+id/w_mon" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:background="@drawable/widget_cal_head_sm"
            android:text="BILLS" android:textColor="#FFFFFF" android:textSize="8sp" android:textStyle="bold" android:maxLines="1" />
        <TextView android:id="@+id/w_day" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
            android:text="•" android:textColor="#1A1A1A" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
        <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#A8A8AA" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_total" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Rs. ••••" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#A8A8AA" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <ImageView android:id="@+id/w_eye" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginStart="6dp" android:padding="6dp"
        android:background="@drawable/widget_eye_bg" android:src="@drawable/ic_widget_eye_off" android:contentDescription="Show amounts" />
</LinearLayout>
