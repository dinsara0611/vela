<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_body" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg_orange">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="30dp" android:layout_height="30dp" android:padding="6dp"
            android:background="@drawable/widget_badge_bills" android:src="@drawable/ic_w_bills" android:contentDescription="@null" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="vertical">
            <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Bills coming" android:textColor="#A8A8AA" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/w_total" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Rs. ••••" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <ImageView android:id="@+id/w_eye" android:layout_width="28dp" android:layout_height="28dp" android:padding="6dp"
            android:background="@drawable/widget_eye_bg" android:src="@drawable/ic_widget_eye_off" android:contentDescription="Show amounts" />
    </LinearLayout>
    <TextView android:id="@+id/w_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp"
        android:text="Open Vela to load" android:textColor="#A8A8AA" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
    <LinearLayout android:id="@+id/w_row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <LinearLayout android:layout_width="38dp" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/widget_cal_tile_sm">
            <TextView android:id="@+id/w_mon1" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:background="@drawable/widget_cal_head_sm"
                android:textColor="#FFFFFF" android:textSize="8sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/w_day1" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
                android:textColor="#1A1A1A" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:id="@+id/w_name1" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/w_when1" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFA24C" android:textSize="10sp" android:maxLines="1" />
        </LinearLayout>
        <TextView android:id="@+id/w_amt1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <LinearLayout android:layout_width="38dp" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/widget_cal_tile_sm">
            <TextView android:id="@+id/w_mon2" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:background="@drawable/widget_cal_head_sm"
                android:textColor="#FFFFFF" android:textSize="8sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/w_day2" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
                android:textColor="#1A1A1A" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:id="@+id/w_name2" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/w_when2" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFA24C" android:textSize="10sp" android:maxLines="1" />
        </LinearLayout>
        <TextView android:id="@+id/w_amt2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_row3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <LinearLayout android:layout_width="38dp" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/widget_cal_tile_sm">
            <TextView android:id="@+id/w_mon3" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:background="@drawable/widget_cal_head_sm"
                android:textColor="#FFFFFF" android:textSize="8sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/w_day3" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
                android:textColor="#1A1A1A" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:id="@+id/w_name3" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/w_when3" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFA24C" android:textSize="10sp" android:maxLines="1" />
        </LinearLayout>
        <TextView android:id="@+id/w_amt3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_row4" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <LinearLayout android:layout_width="38dp" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/widget_cal_tile_sm">
            <TextView android:id="@+id/w_mon4" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:background="@drawable/widget_cal_head_sm"
                android:textColor="#FFFFFF" android:textSize="8sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/w_day4" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
                android:textColor="#1A1A1A" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:id="@+id/w_name4" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/w_when4" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFA24C" android:textSize="10sp" android:maxLines="1" />
        </LinearLayout>
        <TextView android:id="@+id/w_amt4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
