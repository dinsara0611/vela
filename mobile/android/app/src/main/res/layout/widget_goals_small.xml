<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_body" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_bg_pink">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:padding="5dp"
            android:background="@drawable/widget_badge_goals" android:src="@drawable/ic_w_goals" android:contentDescription="@null" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="vertical">
            <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Goals" android:textColor="#A8A8AA" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <ImageView android:id="@+id/w_eye" android:layout_width="28dp" android:layout_height="28dp" android:padding="6dp"
            android:background="@drawable/widget_eye_bg" android:src="@drawable/ic_widget_eye_off" android:contentDescription="Show amounts" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="4dp" android:layout_marginBottom="2dp">
        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
            <ImageView android:id="@+id/w_ring" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter"
                android:src="@drawable/widget_ring_pink" android:contentDescription="@null" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:orientation="vertical" android:gravity="center_horizontal">
                <TextView android:id="@+id/w_pct" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0%" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold" android:maxLines="1" />
                <TextView android:id="@+id/w_pct_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="saved" android:textColor="#A8A8AA" android:textSize="9sp" android:maxLines="1" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
    <TextView android:id="@+id/w_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
        android:text="Your goals" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/w_total" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
        android:text="Rs. ••••" android:textColor="#A8A8AA" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
