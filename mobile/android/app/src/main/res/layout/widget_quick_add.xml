<?xml version="1.0" encoding="utf-8"?>
<!-- Vela quick-add widget: new expense, income or transfer in one tap. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:id="@+id/wq_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:padding="5dp"
            android:background="@drawable/widget_badge_quick" android:src="@drawable/ic_w_quick" android:contentDescription="@null" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:text="Quick add" android:textColor="#A8A8AA" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <LinearLayout android:id="@+id/wq_expense" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="horizontal" android:gravity="center" android:background="@drawable/widget_btn_expense">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_w_expense" android:contentDescription="Expense" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="Expense" android:textColor="#FF7A88" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/wq_income" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp"
            android:orientation="horizontal" android:gravity="center" android:background="@drawable/widget_btn_income">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_w_income" android:contentDescription="Income" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="Income" android:textColor="#1EE88A" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/wq_transfer" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp"
            android:orientation="horizontal" android:gravity="center" android:background="@drawable/widget_btn_neutral">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_w_transfer" android:contentDescription="Transfer" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="Transfer" android:textColor="#C9A6FF" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
