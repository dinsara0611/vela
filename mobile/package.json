{
  "name": "vela-mobile",
  "version": "4.62.3",
  "private": true,
  "description": "Vela Android app (Capacitor wrapper around the web app in the repository root).",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "icons": "node scripts/make-icons.mjs && capacitor-assets generate --android --iconBackgroundColor \"#07070b\" --iconBackgroundColorDark \"#07070b\" --splashBackgroundColor \"#07070b\" --splashBackgroundColorDark \"#07070b\"",
    "sync": "npm run build:web && cap sync android",
    "apk": "npm run sync && cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@capgo/capacitor-native-biometric": "8.9.1",
    "@fontsource/inter": "5.3.0",
    "@fontsource/outfit": "5.3.0",
    "@supabase/supabase-js": "2.118.0",
    "chart.js": "4.4.1",
    "jspdf": "2.5.2"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3"
  },
  "allowScripts": {
    "sharp@0.32.6": true
  }
}
