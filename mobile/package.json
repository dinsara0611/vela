{
  "name": "vela-mobile",
  "version": "4.4.0",
  "private": true,
  "description": "Vela Android app (Capacitor wrapper around the web app in the repository root).",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "icons": "node scripts/make-icons.mjs && capacitor-assets generate --android --iconBackgroundColor \"#07070b\" --iconBackgroundColorDark \"#07070b\" --splashBackgroundColor \"#07070b\" --splashBackgroundColorDark \"#07070b\"",
    "sync": "npm run build:web && cap sync android",
    "apk": "npm run sync && cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "6.2.3",
    "@capacitor/app": "6.0.3",
    "@capacitor/browser": "6.0.6",
    "@capacitor/core": "6.2.3",
    "@capacitor/filesystem": "6.0.4",
    "@capacitor/haptics": "6.0.3",
    "@capacitor/local-notifications": "6.1.3",
    "@capacitor/share": "6.0.4",
    "@capacitor/splash-screen": "6.0.4",
    "@capacitor/status-bar": "6.0.3",
    "@capgo/capacitor-native-biometric": "6.0.4",
    "@fontsource/inter": "5.3.0",
    "@fontsource/outfit": "5.3.0",
    "@supabase/supabase-js": "2.118.0",
    "chart.js": "4.4.1",
    "jspdf": "2.5.2"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "6.2.3"
  },
  "allowScripts": {
    "sharp@0.32.6": true
  }
}
